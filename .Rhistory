render_comparison <- function(title, r_code, python_code, level = 6) {
cat("\n", strrep("#", level), " ", title, "\n\n", sep = "")
cat(':::::::::::::: {.grid}\n')
cat('::: {.g-col-6}\n')
cat("```{.r}\n", r_code, "\n```\n", sep = "")
cat(':::\n\n')
cat('::: {.g-col-6}\n')
cat("```{.python}\n", python_code, "\n```\n", sep = "")
cat(':::\n')
cat('::::::::::::::\n\n')
}
